# Copy to .env and fill in. See docs/api-setup.md.

# Required. Email or URL Wikimedia can use to contact you; goes into the User-Agent.
WIKIVOYAGE_CONTACT=you@example.com
APP_URL=https://github.com/risal-ea/wayFinder

# Optional tuning
# WIKIVOYAGE_LANG=en
# WIKIVOYAGE_MIN_INTERVAL=0.2
# HTTP_TIMEOUT=30

# Later phases
# REDIS_URL=redis://localhost:6379/0
