{
  "info": {
    "name": "WayFinder",
    "description": "**WayFinder API (local)**: our backend: parsed articles, sections and listings. Start the server first (see the folder description).\n\n**Wikivoyage**: the raw API calls the backend makes. No key needed; set `user_agent` to include your contact.\n\nChange `title`, `district`, `query`, `lat`, `lon` in the collection variables to try other places.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "wv_api",
      "value": "https://en.wikivoyage.org/w/api.php"
    },
    {
      "key": "user_agent",
      "value": "WayFinder/0.1 (https://github.com/risal-ea/wayFinder; you@example.com) Postman"
    },
    {
      "key": "title",
      "value": "Kyoto"
    },
    {
      "key": "query",
      "value": "Kyoto"
    },
    {
      "key": "section",
      "value": "1"
    },
    {
      "key": "lat",
      "value": "35.0116"
    },
    {
      "key": "lon",
      "value": "135.7681"
    },
    {
      "key": "api",
      "value": "http://localhost:8000"
    },
    {
      "key": "district",
      "value": "Kyoto/Higashiyama"
    }
  ],
  "item": [
    {
      "name": "WayFinder API (local, run the server first)",
      "description": "Our own backend. Start it first:\n\n```\ncd backend\nuv run uvicorn wayfinder.api.app:app --reload\n```\n\nInteractive docs: http://localhost:8000/docs",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/health",
              "host": [
                "{{api}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            },
            "description": "Is the server running?"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ok', () => pm.expect(body.status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/search?q={{query}}&limit=10",
              "host": [
                "{{api}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{query}}"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Find articles by name."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Has results', () => pm.expect(body.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/resolve?title=Peking",
              "host": [
                "{{api}}"
              ],
              "path": [
                "resolve"
