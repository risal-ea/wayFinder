# Wayfinder AI Configuration
DEBUG=True
SECRET_KEY=wayfinder-insecure-dev-secret-key-change-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite for local development; can use PostgreSQL)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/wayfinder_db

# Cache Configuration (LocMem for dev / testing, Redis for production)
CACHE_URL=locmem://
# For Redis: redis://localhost:6379/1

# Travel Provider Configuration
PROVIDER_MODE=mock # Options: 'mock', 'amadeus'
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENVIRONMENT=test # Options: 'test', 'production'

# Affiliate Monetization
BOOKING_AFFILIATE_ID=wayfinder_aff_default_01

# AI Layer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

